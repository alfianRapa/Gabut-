---
// src/pages/project.astro

const projects = [
  {
    id: 1,
    image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop",
    link: "#",
  },
  {
    id: 2,
    image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop",
    link: "#",
  },
  {
    id: 3,
    image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop",
    link: "#",
  },
  {
    id: 4,
    image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop",
    link: "#",
  },
];
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Projects Showcase</title>
  </head>
  <body class="bg-[#0b0b0b] min-h-screen flex items-center justify-center p-4 font-sans text-neutral-100">

    <!-- Container Utama Gelap (Kotak Luar) -->
    <main class="w-full max-w-[620px] bg-[#161616] border border-[#242424] rounded-3xl p-5 shadow-2xl">
      
      <!-- Badge / Header "Projects" di Pojok Kiri Atas -->
      <div class="mb-4">
        <span class="inline-block bg-[#242424] text-[#d4d4d4] text-xs font-semibold px-3 py-1.5 rounded-lg border border-[#303030]">
          Projects
        </span>
      </div>

      <!-- Grid 2x2 Kolom Presisi -->
      <div class="grid grid-cols-2 gap-3.5">
        {projects.map((project) => (
          <div class="bg-[#1d1d1d] border border-[#2a2a2a] rounded-2xl p-3 flex flex-col justify-between">
            
            <!-- Frame Gambar dengan Border Radius Sesuai Foto -->
            <div class="overflow-hidden rounded-xl aspect-[4/3] w-full">
              <img 
                src={project.image} 
                alt="Project Thumbnail" 
                class="w-full h-full object-cover rounded-xl"
              />
            </div>

            <!-- Tombol Panah Kanan (Pojok Kanan Bawah Card) -->
            <div class="mt-4 flex justify-end">
              <a 
                href={project.link}
                aria-label="Detail Project"
                class="w-8 h-8 bg-[#282828] hover:bg-[#333333] border border-[#353535] rounded-lg flex items-center justify-center text-[#7e7e7e] hover:text-white transition-colors"
              >
                <!-- SVG Icon Panah Kanan -->
                <svg 
                  xmlns="http://www.w3.org/2000/svg" 
                  viewBox="0 0 20 20" 
                  fill="currentColor" 
                  class="w-4 h-4"
                >
                  <path 
                    fill-rule="evenodd" 
                    d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" 
                    clip-rule="evenodd" 
                  />
                </svg>
              </a>
            </div>

          </div>
        ))}
      </div>

    </main>

  </body>
</html>