---
const card = [
  {
    title: "Shinigami",
    username: "rafa syf",
    logo: "https://avatars.githubusercontent.com/u/101159410?s=200&v=4",
    type: "Reading Platform",
    description: "Website baca manhwa lengkap ygy",
    link: "https://11.shinigami.asia/",
  },
  {
    title: "Animein",
    username: "Rapaa17",
    logo: "data:image/jpeg;base64,",
    type: "Anime Streaming",
    description: "Tempat nonton anime.",
    link: "https://animeinweb.com/",
  },
  {
    title: "Github",
    username: "alfianRapa",
    description: "ya gitu lah pokonya",
    logo: "data:image/png;base64,",
    type: "platfrom",
    link: "https://github.com/alfianRapa",
  },
];
---

       <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 w-full">

  {card.map((item) => (
    <a href={item.link} target="_blank" rel="noopener noreferrer" class="block rounded-2xl bg-[var(--card)] p-4 text-[var(--text)] transition-all duration-300 hover:-translate-y-1 hover:ring-1 hover:ring-[var(--accent)]"
    >
      <div class="flex items-center justify-between mb-5">

        <div class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl bg-[var(--accent)]/10">

          {item.logo ? (
            <img
              src={item.logo}
              alt={`Logo ${item.title}`}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          ) : (
            <span class="text-xl font-bold text-[var(--accent)]">
              {item.title.charAt(0)}
            </span>
          )}

        </div>

        <span class="text-xs text-[var(--muted)]">
          {item.type}
        </span>

      </div>

      <div class="flex flex-col gap-1">

        <h2 class="font-semibold text-base">
          {item.title}
        </h2>

        <p class="text-xs text-[var(--accent)]">
          {item.username}
        </p>

        <p class="mt-2 text-sm text-[var(--secondary)]">
          {item.description}
        </p>

        <p class="mt-3 text-xs text-[var(--accent)]">
          Visit Website ↗
        </p>

      </div>

    </a>
  ))}

</div>