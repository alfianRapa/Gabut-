---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Project", href: "/project" },
];

const currentPath = Astro.url.pathname;
---

<nav class="flex w-full items-center justify-start gap-5 overflow-x-auto whitespace-nowrap rounded-2xl border border-zinc-800 bg-[var(--card)] px-5 py-5">
  {navLinks.map((link) => (
    <a
      href={link.href}
      class:list={[
        "shrink-0 text-lg font-medium transition-colors duration-200",
        currentPath === link.href
          ? "text-blue-400 font-semibold"
          : "text-[var(--secondary)] hover:text-[var(--text)]",
      ]}
    >
      {link.name}
    </a>
  ))}
</nav>
