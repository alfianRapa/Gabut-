---
// src/components/Navbar.astro

// Opsional: Menerima prop pathname aktif untuk highlight menu yang sedang dibuka

const { pathname = Astro.url.pathname } = Astro.props;

const navLinks = [
  { name: "About", href: "/about" },
  { name: "Project", href: "/project" },
  { name: "ID Game", href: "/id_game" },
];
---

<header class="sticky top-4 z-50 w-full max-w-3xl mx-auto px-4">
  <nav class="flex items-center justify-between px-4 py-2.5 rounded-2xl bg-[#141414]/80 backdrop-blur-md border border-neutral-800/80 shadow-xl">
    
    <!-- Brand / Logo -->
    <a href="/" class="text-xs font-semibold text-neutral-200 hover:text-white transition-colors flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
      <span class="tracking-wide">Portfolio</span>
    </a>

    <!-- Desktop Links -->
    <ul class="hidden sm:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = pathname === link.href || pathname.startsWith(link.href + "/");
        return (
          <li>
            <a
              href={link.href}
              class={`px-3 py-1.5 text-xs font-medium rounded-xl transition-all duration-200 ${
                isActive
                  ? "bg-neutral-800 text-white border border-neutral-700/60 shadow-sm"
                  : "text-neutral-400 hover:text-neutral-100 hover:bg-neutral-800/50"
              }`}
            >
              {link.name}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Mobile Menu Button -->
    <button
      id="navbar-toggle"
      type="button"
      aria-label="Toggle Menu"
      class="sm:hidden p-1.5 text-neutral-400 hover:text-white hover:bg-neutral-800/80 rounded-lg transition-colors focus:outline-none"
    >
      <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-dropdown" class="hidden sm:hidden mt-2 p-2 rounded-2xl bg-[#141414]/95 backdrop-blur-md border border-neutral-800/80 shadow-2xl flex flex-col gap-1">
    {navLinks.map((link) => {
      const isActive = pathname === link.href;
      return (
        <a
          href={link.href}
          class={`px-4 py-2 text-xs font-medium rounded-xl transition-colors ${
            isActive
              ? "bg-neutral-800 text-white font-semibold"
              : "text-neutral-300 hover:bg-neutral-800/60 hover:text-white"
          }`}
        >
          {link.name}
        </a>
      );
    })}
  </div>
</header>

<script>
  // Script interaktivitas mobile menu (Client-side)
  const toggleBtn = document.getElementById('navbar-toggle');
  const dropdown = document.getElementById('mobile-dropdown');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  toggleBtn?.addEventListener('click', () => {
    dropdown?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>