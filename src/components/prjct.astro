---
const projects = [
  {
    id: 1,
    title: "Ngecor.id",
    description:
      "Aplikasi web untuk menghitung kebutuhan bangunan dan material. Pengguna memasukkan dimensi pekerjaan, lalu sistem menghitung kebutuhan bahan dan RAB. Dilengkapi panduan SOP, checklist K3, simulasi slump test, dan pemesanan bahan melalui WhatsApp.",
    image: "/project/ngecorid-removebg-preview.png",
    tags: ["HTML", "JavaScript", "Tailwind"],
    link: "https://ngecorid.vercel.app/",
  },
  {
  id: 2,
  title: "Web Toko",
  description:
    "Website toko online yang menampilkan berbagai produk dengan tampilan antarmuka sederhana dan responsif.",
  image: "/project/tokoKita.png",
  tags: ["HTML", "CSS", "JavaScript"],
  link: "https://web-toko-seven.vercel.app/",
},
{
  id: 3,
  title: "Kalkulator",
  description:
    "Aplikasi kalkulator berbasis web untuk melakukan perhitungan matematika dasar dengan antarmuka yang sederhana.",
  image: "/project/kalkulator.png",
  tags: ["HTML", "CSS", "JavaScript"],
  link: "https://alfianrapa.github.io/kalkulator/",
}
];
---
  
<section
    id="projects"
    class="w-full rounded-2xl bg-[var(--card)] p-3 text-[var(--text)] sm:p-5"
  >

   

    <div class="mb-4">
      <span class="inline-block rounded-lg bg-[color-mix(in_srgb,var(--text)_8%,transparent)] px-3 py-2 text-base font-semibold">
        Projects
      </span>
    </div>

    <div class="flex flex-col gap-4">

      {projects.map((project) => (
        <article class="rounded-xl bg-[color-mix(in_srgb,var(--text)_5%,transparent)] p-3 sm:p-4">

    <!-- Image -->
          <div
            class={`project-image-frame flex h-36 w-full items-center justify-center overflow-hidden rounded-lg sm:h-60 md:h-64 ${
              project.id === 1
                ? "ngecor-frame"
                : project.id === 2
                  ? "website-frame"
                  : "calculator-frame"
            }`}
          >
            <img
              src={project.image}
              alt={project.title}
              loading="lazy"
              class={
                project.id === 1
                  ? "ngecor-image"
                  : project.id === 2
                    ? "website-image"
                    : "calculator-image"
              }
            />
          </div>
          <!-- Project Information -->
          <div class="mt-4 space-y-2">

            <h2 class="text-xl font-bold sm:text-2xl">
              {project.title}
            </h2>

            <p class="text-sm leading-relaxed text-[var(--secondary)] sm:text-base">
              {project.description}
            </p>

          </div>

          <!-- Tags and Link -->
          <div class="mt-4 flex items-center justify-between gap-3">

            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="rounded-md bg-[color-mix(in_srgb,var(--text)_8%,transparent)] px-2.5 py-1 text-xs font-medium sm:text-sm">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Lihat ${project.title}`}
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[color-mix(in_srgb,var(--text)_8%,transparent)] transition hover:bg-[color-mix(in_srgb,var(--text)_15%,transparent)]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-5 w-5"
              >
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>

          </div>

        </article>
      ))}

    </div>

  </section>