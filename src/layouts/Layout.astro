---
import "../style/global.css";
import Navbar from "../components/nav.astro";

const { title = "Alfian Rafa | Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#141414" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen">

    <div class="mx-auto w-full max-w-170 px-4 pt-7 sm:px-5 sm:pt-8">

      <Navbar />

      <main class="mt-3 flex w-full flex-col gap-3">
        <slot />
      </main>

    </div>

  </body>
</html>
