---
import "../style/global.css"
import Navbar from "../components/nav.astro"
import C from "../components/clock.astro"
const projects = [
  { 
    id: 1,
    title: "Project 1",
    image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop",
    link: "#",
  },
  {
    id: 2,
    title: "Project 2",
    image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop",
    link: "#",
  },
  {
    id: 3,
    title: "Project 3",
    image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop",
    link: "#",
  },
  {
    id: 4,
    title: "Project 4",
    image: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop",
    link: "#",
  },
];
---

<Navbar/>
<section id="projects" class="w-full rounded-2xl bg-[var(--card)] p-3 sm:p-4 text-[var(--text)]">
    <C/>
    <div class="mb-3">
    <span class="inline-flex items-center rounded-lg border border-[var(--muted)]/30 bg-[var(--badge)] px-3 py-1 text-[10px] font-semibold text-[var(--text)] sm:px-4 sm:py-1.5 sm:text-xs md:text-sm">
      Projects
    </span>
  </div>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-3.5">
    {projects.map((project) => (
      <div class="flex flex-col justify-between rounded-2xl border border-[var(--muted)]/20 bg-[var(--card)] p-3">
        <div class="aspect-[4/3] w-full overflow-hidden rounded-xl">
          <img src={project.image} alt="Project thumbnail" loading="lazy" class="h-full w-full object-cover" />
        </div>
        <div class="mt-4 flex justify-end">
          <a
            href={project.link}
            aria-label="Detail project"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-[var(--muted)]/30 bg-[var(--badge)] text-[var(--muted)] transition-colors hover:text-[var(--text)]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>