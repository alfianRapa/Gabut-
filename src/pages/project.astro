---
import "../style/global.css";
import Navbar from "../components/nav.astro";
import C from "../components/clock.astro";
// test

const projects = [
  {
    id: 1,
    title: "Ngecor.id",
    description:
      "Aplikasi web untuk menghitung kebutuhan bangunan dan material. Pengguna memasukkan dimensi pekerjaan, lalu sistem menghitung kebutuhan bahan dan RAB. Dilengkapi panduan SOP, checklist K3, simulasi slump test, dan pemesanan bahan melalui WhatsApp.",
    image: "/project/ngecorid.jpg",
    tags: ["HTML", "CSS", "JavaScript", "Tailwind"],
    link: "https://ngecorid.vercel.app/",
  },
];
---

<Navbar />

<section
  id="projects"
  class="w-full rounded-2xl bg-[var(--card)] p-4 text-[var(--text)] sm:p-5"
>
  <C />

  <!-- Badge -->
  <div class="mb-5">
    <span class="inline-block rounded-xl bg-[color-mix(in_srgb,var(--text)_8%,transparent)] px-4 py-2 text-lg font-semibold">
      Projects
    </span>
  </div>

  <!-- Project List -->
  <div class="flex flex-col gap-4">
    {projects.map((project) => (
      <article class="rounded-2xl bg-[color-mix(in_srgb,var(--text)_5%,transparent)] p-4 sm:p-5">

           <!-- Image -->
        <div class="h-48 w-full overflow-hidden rounded-xl bg-white sm:h-56 md:h-64">
          <img src={project.image} alt={project.title} loading="lazy" class="h-full w-full object-contain"/>
        </div>

        <!-- Project Info -->
        <div class="mt-5 space-y-2">
          <h3 class="text-2xl font-bold">
            {project.title}
          </h3>

          <p class="text-base leading-relaxed text-[var(--secondary)] sm:text-lg">
            {project.description}
          </p>
        </div>

        <!-- Tags and Link -->
        <div class="mt-5 flex items-center justify-between gap-3">

          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-lg bg-[color-mix(in_srgb,var(--text)_8%,transparent)] px-3 py-1.5 text-sm font-medium">
                {tag}
              </span>
            ))}
          </div>

          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Lihat ${project.title}`}
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[color-mix(in_srgb,var(--text)_8%,transparent)] transition hover:bg-[color-mix(in_srgb,var(--text)_15%,transparent)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-5 w-5"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>

        </div>
      </article>
    ))}
  </div>
</section>
