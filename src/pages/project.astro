---
import "../style/global.css"
import Navbar from "../components/nav.astro"
import C from "../components/clock.astro"
const projects = [
  {
    id: 1,
    title: "Ngecor.id",
    description:
      "Aplikasi web untuk menghitung kebutuhan bangunan dan material. Pengguna memasukkan dimensi pekerjaan (batako, bata merah, cor beton, plesteran, acian), lalu sistem menghitung kebutuhan bahan netto dan bruto beserta RAB. Ada panduan SOP lapangan, checklist K3 yang menerbitkan surat izin kerja, simulasi slump test, dan pemesanan bahan ke toko mitra lewat WhatsApp.",
    image: "/project/ngecorid.jpg",
    tags: ["HTML", "CSS", "JavaScript", "Tailwind"],
    link: "https://ngecorid.vercel.app/",
  },
];
---
<Navbar/>
<section
  id="projects"
  class="w-full rounded-2xl bg-[var(--card)] p-3 text-[var(--text)] sm:p-4"
> <C/>

  <!-- Badge -->
  <div class="mb-3">
    <span
      class="inline-flex items-center rounded-lg bg-[color-mix(in_srgb,var(--text)_8%,transparent)] px-2.5 py-1 text-[10px] font-semibold text-[var(--text)] sm:px-3 sm:text-xs"
    >
      Projects
    </span>
  </div>

  <!-- Daftar project -->
  <div class="flex flex-col gap-2.5 sm:gap-3">
    {projects.map((project) => (
      <article
        class="rounded-xl bg-[color-mix(in_srgb,var(--text)_5%,transparent)] p-2.5 sm:p-3"
      >
        <!-- Gambar -->
        <div class="aspect-[16/7] w-full overflow-hidden rounded-lg bg-white">
          <img
            src={project.image}
            alt={project.title}
            loading="lazy"
            class="h-full w-full object-contain"
          />
        </div>

        <!-- Judul + deskripsi -->
        <div class="mt-2.5 space-y-1">
          <h3 class="text-xs font-semibold text-[var(--text)] sm:text-sm">
            {project.title}
          </h3>
          <p class="text-[10px] leading-relaxed text-[var(--muted)] sm:text-[11px]">
            {project.description}
          </p>
        </div>

        <!-- Tag + tombol panah -->
        <div class="mt-2.5 flex items-end justify-between gap-2">
          <ul class="flex flex-wrap gap-1">
            {project.tags.map((tag) => (
              <li
                class="rounded bg-[color-mix(in_srgb,var(--text)_8%,transparent)] px-1.5 py-0.5 text-[9px] font-medium text-[var(--text)] sm:text-[10px]"
              >
                {tag}
              </li>
            ))}
          </ul>

          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Lihat ${project.title}`}
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[color-mix(in_srgb,var(--text)_8%,transparent)] text-[var(--muted)] transition-colors hover:bg-[color-mix(in_srgb,var(--text)_15%,transparent)] hover:text-[var(--text)]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>